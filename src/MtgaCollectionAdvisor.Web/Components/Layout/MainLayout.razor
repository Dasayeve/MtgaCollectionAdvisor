@inherits LayoutComponentBase
@implements IDisposable
@inject AdvisorSession Session
@inject AppUpdater Updater

@* On a first run the setup screen is the whole window: no top bar or buttons to wander off to. *@
@if (Session.Setup is not null)
{
    <SetupScreen />
}
else
{
    <div class="app">
        <header class="topbar">
            <div class="brand">MTGA Deck Advisor</div>

            @* Only when there is somewhere else to go: with the Creators tab off, the top bar
               is exactly what it was before it existed. *@
            @if (Session.CreatorVideosEnabled)
            {
                <nav class="topnav">
                    <NavLink href="" Match="NavLinkMatch.All">Decks</NavLink>
                    <NavLink href="creators">Creators</NavLink>
                </nav>
            }

            @* Never read is not zero (#57): unknown totals show as "—", and the deck list says
               what to do in MTG Arena. *@
            @{ var wallet = Session.Collection.Wildcards; }
            <div class="wallet" title="@Session.WildcardHint">
                <span><strong>@Session.Collection.OwnedByGrpId.Count.ToString("N0")</strong> cards</span>
                @* With a deck open, a total that can't cover it says by how much. *@
                @{ var open = Session.OpenDeckNeed; }
                @WalletTotal("common", "Common", wallet?.Commons, open?.Commons)
                @WalletTotal("uncommon", "Uncommon", wallet?.Uncommons, open?.Uncommons)
                @WalletTotal("rare", "Rare", wallet?.Rares, open?.Rares)
                @WalletTotal("mythic", "Mythic", wallet?.Mythics, open?.Mythics)
            </div>

            <div class="actions">
                <button class="primary" disabled="@Session.IsBusy"
                        title="Reads your collection straight from MTG Arena's memory (the game must be running). Takes ~1-2 minutes the first time."
                        @onclick="() => Session.ScanCollectionAsync()">
                    Capture collection
                </button>
                <button disabled="@Session.IsBusy"
                        title="Adds the latest public @Session.Format.DisplayName decks from Archidekt to the pool, reading only what is new or changed since the last fetch. Pinned decks are never touched."
                        @onclick="() => Session.FetchDecksAsync()">
                    Fetch decks
                </button>
                <button disabled="@Session.IsBusy"
                        title="Adds a deck by pasting a list in Arena's export format, or picks from the decks saved in Arena."
                        @onclick="() => _showImportDeck = true">
                    Import deck
                </button>

                @* The occasional actions, out of the way of the three used every session.
                   Exports are plain download links: the files are written by the /export
                   endpoints, and Blazor leaves an anchor with a download attribute to the browser. *@
                <div class="menu">
                    <button aria-haspopup="true" aria-expanded="@(_showMenu ? "true" : "false")"
                            @onclick="() => _showMenu = !_showMenu">
                        More <span aria-hidden="true">▾</span>
                    </button>
                    @if (_showMenu)
                    {
                        var hasCollection = Session.Collection.OwnedByGrpId.Count > 0;
                        @* A click anywhere else closes the menu. *@
                        <div class="menu-dismiss" @onclick="() => _showMenu = false"></div>
                        <div class="menu-options" role="menu">
                            <button role="menuitem" disabled="@Session.IsBusy" @onclick="RefreshCardsAsync">
                                Update cards <span>Re-download the Scryfall card database (a few minutes)</span>
                            </button>

                            <div class="menu-heading">Export</div>
                            <a role="menuitem" href="export/collection.txt" download
                               class="@(hasCollection ? "" : "disabled")" @onclick="() => _showMenu = false">
                                Collection <span>Arena list (.txt)</span>
                            </a>
                            <a role="menuitem" href="export/collection.json" download
                               class="@(hasCollection ? "" : "disabled")" @onclick="() => _showMenu = false">
                                Collection <span>With wildcards (.json)</span>
                            </a>
                            <a role="menuitem" href="export/user-decks.zip" download @onclick="() => _showMenu = false">
                                My decks <span>One file per deck (.zip)</span>
                            </a>
                            @* Arena writes its saved decks to Player.log at login; the last list seen is kept. *@
                            @{ var arenaCaptured = Session.ArenaDecksCapturedAt; }
                            <a role="menuitem" href="export/arena-decks.zip" download
                               class="@(arenaCaptured is null ? "disabled" : "")" @onclick="() => _showMenu = false">
                                Decks saved in Arena
                                <span>@(arenaCaptured is { } at ? $"Read from Player.log on {at.ToLocalTime():g} (.zip)" : "Log in to MTG Arena first")</span>
                            </a>
                            <a role="menuitem" href="export/arena-decks.zip?all=true" download
                               class="@(arenaCaptured is null ? "disabled" : "")" @onclick="() => _showMenu = false">
                                Decks saved in Arena, with Wizards' decks <span>Adds precons and suggested decks (.zip)</span>
                            </a>
                        </div>
                    }
                </div>

                @* Handled in the page, not by Blazor: see advisorTheme in App.razor. The icon shows
                   the theme a click leads to, and CSS picks it, so it is right from the first paint. *@
                <button class="theme-switch" title="Switch between the light and dark theme"
                        aria-label="Switch between the light and dark theme" onclick="advisorTheme.toggle()">
                    <svg class="icon-sun" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                        <circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.4" />
                        <path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.05 3.05l1.13 1.13M11.82 11.82l1.13 1.13M3.05 12.95l1.13-1.13M11.82 4.18l1.13-1.13"
                              stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                    </svg>
                    <svg class="icon-moon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                        <path d="M13.5 9.6A5.6 5.6 0 0 1 6.4 2.5a5.6 5.6 0 1 0 7.1 7.1Z"
                              fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                    </svg>
                </button>
            </div>
        </header>

        <main class="page">
            @Body
        </main>

        @* A desktop app's status bar: what the app is doing on the left, the app itself on the right. *@
        <footer class="statusbar">
            @if (Session.IsBusy)
            {
                <span class="spinner" aria-hidden="true"></span>
            }
            <span class="status-text @(Session.StatusLevel == StatusLevel.Warning ? "warning" : "")">@Session.Status</span>

            @if (Updater.ReadyVersion is { } ready)
            {
                <span class="update-ready">
                    Version @ready is ready.
                    <button disabled="@Session.IsBusy"
                            title="@(Session.IsBusy ? "Available once the current operation finishes." : "Restarts the app on the new version. This window reloads by itself.")"
                            @onclick="Updater.RestartToUpdate">
                        Restart to update
                    </button>
                </span>
            }

            <span class="status-links">
                <span title="MTGA Deck Advisor version">v@(Updater.CurrentVersion)</span>
                @* The log files (#52): what to attach when reporting a problem. *@
                <button class="link" title="Open the folder with the app's log files" @onclick="Session.OpenLogFolder">Logs</button>
                <a href="https://github.com/Dasayeve/" target="_blank" rel="noopener" title="github.com/Dasayeve">GitHub</a>
            </span>
        </footer>
    </div>

    @if (_showImportDeck)
    {
        <DeckDialog OnClose="() => _showImportDeck = false" />
    }
}

@code {
    private bool _showImportDeck;
    private bool _showMenu;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Session.OpenDeckChanged += OnSessionChanged;
        Updater.Changed += OnSessionChanged;
    }

    private Task RefreshCardsAsync()
    {
        _showMenu = false;
        return Session.RefreshCardDatabaseAsync();
    }

    private static RenderFragment WalletTotal(string rarity, string label, int? have, int? need) => __builder =>
    {
        var shortBy = have is { } h && need is { } n && n > h ? n - h : 0;
        <span class="wildcard @rarity" title="@(shortBy > 0 ? $"{label} wildcards: the open deck needs {shortBy} more" : $"{label} wildcards")">
            @(have?.ToString() ?? "—")
            @if (shortBy > 0)
            {
                <span class="short-by">−@shortBy</span>
            }
        </span>
    };

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Session.OpenDeckChanged -= OnSessionChanged;
        Updater.Changed -= OnSessionChanged;
    }
}
