@inherits LayoutComponentBase
@implements IDisposable
@inject AdvisorSession Session

<div class="app">
    <header class="topbar">
        <div class="brand">MTGA <span>Collection Advisor</span></div>

        @* SPIKE: second page for creator videos. *@
        <nav class="topnav">
            <NavLink href="" Match="NavLinkMatch.All">Decks</NavLink>
            <NavLink href="creators">Creators</NavLink>
        </nav>

        <div class="topbar-stats">
            <div class="stat">
                <span class="stat-label">Collection</span>
                <span class="stat-value">@Session.Collection.OwnedByGrpId.Count.ToString("N0") cards</span>
            </div>
            <div class="stat">
                <span class="stat-label">Wildcards</span>
                <span class="stat-value wildcard-row">
                    <span class="wildcard common" title="Common">@Session.Collection.Wildcards.Commons</span>
                    <span class="wildcard uncommon" title="Uncommon">@Session.Collection.Wildcards.Uncommons</span>
                    <span class="wildcard rare" title="Rare">@Session.Collection.Wildcards.Rares</span>
                    <span class="wildcard mythic" title="Mythic">@Session.Collection.Wildcards.Mythics</span>
                </span>
            </div>
        </div>

        <div class="actions">
            <button class="primary" disabled="@Session.IsBusy"
                    title="Reads your collection straight from MTG Arena's memory (the game must be running). Takes ~1-2 minutes the first time."
                    @onclick="() => Session.ScanCollectionAsync()">
                Capture collection
            </button>
            <button disabled="@Session.IsBusy"
                    title="Downloads public @Session.Format.DisplayName decks from Archidekt, dropping duplicate lists."
                    @onclick="() => Session.FetchDecksAsync()">
                Fetch decks
            </button>
            <button disabled="@Session.IsBusy"
                    title="Adds a deck by pasting a list in Arena's export format."
                    @onclick="() => _showImportDeck = true">
                Import deck
            </button>
            <button disabled="@Session.IsBusy"
                    title="Re-downloads the Scryfall card database (names, rarities and legality). Takes a few minutes."
                    @onclick="() => Session.RefreshCardDatabaseAsync()">
                Update cards
            </button>
        </div>
    </header>

    <div class="statusbar">
        @if (Session.IsBusy)
        {
            <span class="spinner" aria-hidden="true"></span>
        }
        <span>@Session.Status</span>
    </div>

    @Body

    <footer class="footer">
        <span>By DasaX</span>
        <a href="https://github.com/Dasayeve/" target="_blank" rel="noopener" title="github.com/Dasayeve">
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
                    0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01
                    1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95
                    0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0
                    1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87
                    3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16
                    8c0-4.42-3.58-8-8-8Z" />
            </svg>
        </a>
    </footer>
</div>

@if (_showImportDeck)
{
    <DeckDialog OnClose="() => _showImportDeck = false" />
}

@code {
    private bool _showImportDeck;

    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
