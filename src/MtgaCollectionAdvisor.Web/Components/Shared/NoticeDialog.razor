@using MtgaCollectionAdvisor.Core.Notices

@* A maintainer notice (#96). Plain text only, through Blazor's escaping. Any way out dismisses it
   for good: the button, or a click outside the panel. *@
<div class="modal-backdrop" @onclick="OnDismiss">
    <div class="modal-panel notice-panel" role="dialog" aria-modal="true" aria-labelledby="notice-title" @onclick:stopPropagation>
        <h2 id="notice-title">@Notice.Title</h2>
        <p class="notice-text">@Notice.Text</p>
        <div class="modal-actions">
            <button class="primary" @onclick="OnDismiss">Dismiss</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Notice Notice { get; set; } = null!;
    [Parameter, EditorRequired] public EventCallback OnDismiss { get; set; }
}
