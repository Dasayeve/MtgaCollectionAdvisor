@using MtgaCollectionAdvisor.Core.Arena
@using MtgaCollectionAdvisor.Core.Models
@inject AdvisorSession Session

<div class="modal-backdrop" @onclick="OnCancel">
    <div class="modal-panel" @onclick:stopPropagation>
        <h2>@(IsEdit ? "Edit deck" : _arenaChoices is not null ? "Your Arena decks" : "Import deck")</h2>

        @if (_arenaChoices is not null)
        {
            @* Pick decks saved in MTG Arena to keep in the app. Nothing syncs by itself: what is
               ticked becomes a user deck, which stays here even after it is deleted in Arena. *@
            <p class="hint">
                Read from Player.log on @Session.ArenaDecksCapturedAt?.ToLocalTime().ToString("g").
                Tick the decks to keep in the app - they stay here even if you delete them in Arena,
                and <b>Copy for Arena</b> takes them back.
            </p>

            @if (_arenaChoices.Count == 0)
            {
                <p class="hint">No decks of your own in the list Arena logged.</p>
            }
            else
            {
                @* Ticks survive a filter change: the Add button counts every picked deck. *@
                <div class="segmented arena-filter">
                    @foreach (var (key, label) in ArenaFilters())
                    {
                        var count = ArenaDeckImport.Filter(_arenaChoices, key).Count;
                        // A format the player has no decks in is left out, so the row holds as formats grow.
                        if (count == 0 && key is not null && key != ArenaDeckImport.OtherFormats && _arenaFilter != key) continue;
                        <button class="@(_arenaFilter == key ? "active" : "")" disabled="@(count == 0)"
                                @onclick="() => _arenaFilter = key">
                            @label <span class="count">@count</span>
                        </button>
                    }
                </div>

                <div class="arena-picker">
                    @foreach (var choice in ArenaDeckImport.Filter(_arenaChoices, _arenaFilter))
                    {
                        var id = choice.Deck.Id;
                        <label class="arena-deck @(choice.IsSupported ? "" : "unsupported")">
                            <input type="checkbox" disabled="@(!choice.IsSupported)"
                                   checked="@_picked.Contains(id)" @onchange="() => TogglePick(id)" />
                            <span class="arena-deck-name">@choice.Deck.Name</span>
                            <span class="arena-deck-meta">
                                @(choice.Format?.DisplayName ?? choice.Deck.Format) · @choice.CardCount cards
                                @if (!choice.IsSupported)
                                {
                                    <span> · not supported yet</span>
                                }
                                @if (choice.InApp)
                                {
                                    <span class="badge yes" title="Ticking it again updates it from Arena, pin included">In the app</span>
                                }
                            </span>
                            @if (choice.UnknownCards > 0)
                            {
                                <span class="arena-deck-warning">
                                    @choice.UnknownCards card@(choice.UnknownCards == 1 ? "" : "s") not in the card database - run Update cards first
                                </span>
                            }
                        </label>
                    }
                </div>
            }

            <div class="modal-actions">
                <button @onclick="() => _arenaChoices = null">Back</button>
                <button @onclick="OnCancel">Cancel</button>
                <button class="primary" disabled="@(_picked.Count == 0)" @onclick="ImportArenaDecksAsync">
                    @(_picked.Count == 0 ? "Add decks" : $"Add {_picked.Count} deck{(_picked.Count == 1 ? "" : "s")}")
                </button>
            </div>
        }
        else
        {
            <p class="hint">
                Paste a list in Arena's export format (e.g. <code>4 Lightning Bolt (STA) 42</code>),
                with an optional <code>Sideboard</code> section.
            </p>

            @if (!IsEdit)
            {
                @if (Session.ArenaDecksCapturedAt is { } readAt)
                {
                    <button class="arena-link" @onclick="OpenArenaDecksAsync">
                        See your Arena decks <span>(read from Player.log on @readAt.ToLocalTime().ToString("g"))</span>
                    </button>
                }
                else
                {
                    <p class="hint">To pick from the decks saved in MTG Arena, log in to Arena while this app is running.</p>
                }
            }

            <div class="field">
                <label for="deck-name">Name</label>
                <input id="deck-name" type="text" placeholder="My deck"
                       value="@_name" @oninput="e => _name = e.Value?.ToString() ?? string.Empty" />
            </div>

            <div class="field">
                <label for="deck-format">Format</label>
                <select id="deck-format" @onchange="OnFormatChanged">
                    @foreach (var format in Formats.All)
                    {
                        <option value="@format.Key" selected="@(_format.Key == format.Key)">@format.DisplayName</option>
                    }
                </select>
            </div>

            <div class="field">
                <label for="deck-list">Decklist</label>
                <textarea id="deck-list" class="export-area" placeholder="@DecklistPlaceholder"
                          @oninput="OnDecklistChangedAsync">@_decklist</textarea>
            </div>

            @if (_preview is not null)
            {
                @* What this list would cost, before committing to it. A bare total decides
                   nothing - five commons is pocket change, five mythics is weeks of play. *@
                <div class="wc-preview">
                    <div class="wc-preview-head">
                        <span class="picker-label">Wildcards needed</span>
                        <span class="result-count">
                            @_preview.OwnedFraction.ToString("P0") of the list already yours
                        </span>
                    </div>

                    <WildcardCost Needed="_preview.Needed" UnrecognisedCopies="_preview.UnrecognisedCopies" Large="true" />

                    @if (_preview.UnavailableOnArena.Count > 0)
                    {
                        <div class="deck-warning" title="@AdvisorSession.UnrecognisedHint">Not recognised: @string.Join(", ", _preview.UnavailableOnArena)</div>
                    }
                    @if (_preview.IllegalInFormat.Count > 0)
                    {
                        <div class="deck-warning">Not legal in @_format.DisplayName: @string.Join(", ", _preview.IllegalInFormat)</div>
                    }
                </div>
            }

            @if (_error is not null)
            {
                <p class="error-text">@_error</p>
            }

            <div class="modal-actions">
                <button @onclick="OnCancel">Cancel</button>
                <button class="primary" @onclick="SaveAsync">@(IsEdit ? "Save" : "Import")</button>
            </div>
        }
    </div>
</div>

@code {
    // Real line breaks: Blazor escapes an attribute's text, so "&#10;" in the markup showed as is.
    private const string DecklistPlaceholder = "Deck\n4 Card Name\n...";

    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>The deck being edited; null opens the dialog for a new one.</summary>
    [Parameter] public CandidateDeck? Deck { get; set; }

    // A new deck can open pre-filled - from a creator video, which then becomes its source.
    // Ignored when editing: an existing deck already has its own values.
    [Parameter] public string? InitialName { get; set; }
    [Parameter] public string? InitialDecklist { get; set; }
    [Parameter] public FormatDefinition? InitialFormat { get; set; }
    [Parameter] public string SourceUrl { get; set; } = "";

    private bool IsEdit => Deck is not null;

    private string _name = string.Empty;
    private string _decklist = string.Empty;
    private FormatDefinition _format = Formats.Standard;
    private string? _error;
    private DeckAnalysisResult? _preview;
    private int _previewToken;

    protected override void OnInitialized()
    {
        if (Deck is null)
        {
            _format = InitialFormat ?? Session.Format;
            _name = InitialName ?? string.Empty;
            _decklist = InitialDecklist ?? string.Empty;
            return;
        }

        _name = Deck.Name;
        _format = Formats.All.FirstOrDefault(f => f.Key == Deck.FormatKey) ?? Session.Format;
        _decklist = Session.ExportDeck(Deck);
    }

    // The edit dialog opens with a list already in it, so it should open with its cost too.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _decklist.Length > 0) await RefreshPreviewAsync();
    }

    private async Task OnFormatChanged(ChangeEventArgs e)
    {
        var key = e.Value?.ToString();
        _format = Formats.All.FirstOrDefault(f => f.Key == key) ?? Formats.Standard;

        // Legality is per format, so the same list can cost differently under each.
        await RefreshPreviewAsync();
    }

    private async Task OnDecklistChangedAsync(ChangeEventArgs e)
    {
        _decklist = e.Value?.ToString() ?? string.Empty;
        await RefreshPreviewAsync();
    }

    /// <summary>
    /// Debounced: pasting 60 lines fires an event per keystroke, and each preview is a
    /// query per distinct card name. The token makes every earlier pass discard itself.
    /// </summary>
    private async Task RefreshPreviewAsync()
    {
        var token = ++_previewToken;
        await Task.Delay(300);
        if (token != _previewToken) return;

        var result = await Session.PreviewDeckAsync(_format, _decklist);
        if (token != _previewToken) return;

        _preview = result;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_name)) { _error = "Give the deck a name."; return; }
        if (string.IsNullOrWhiteSpace(_decklist)) { _error = "Paste the decklist."; return; }

        if (Deck is null)
        {
            await Session.ImportDeckAsync(_name.Trim(), _format, _decklist, SourceUrl);
        }
        else
        {
            await Session.UpdateDeckAsync(Deck, _name.Trim(), _format, _decklist);
        }

        await OnClose.InvokeAsync();
    }

    private Task OnCancel() => OnClose.InvokeAsync();

    // ---------- Decks saved in Arena ----------

    /// <summary>Null while pasting; the picker's list once opened.</summary>
    private IReadOnlyList<ArenaDeckChoice>? _arenaChoices;
    private readonly HashSet<string> _picked = [];

    /// <summary>A format key, <see cref="ArenaDeckImport.OtherFormats"/>, or null for all.</summary>
    private string? _arenaFilter;

    private static IEnumerable<(string? Key, string Label)> ArenaFilters() =>
        [(null, "All"), .. Formats.All.Select(f => ((string?)f.Key, f.DisplayName)), (ArenaDeckImport.OtherFormats, "Other")];

    private async Task OpenArenaDecksAsync()
    {
        _picked.Clear();
        _arenaChoices = await Session.GetArenaDeckChoicesAsync();

        // Open on the format the user is looking at, unless they have no decks in it.
        _arenaFilter = ArenaDeckImport.Filter(_arenaChoices, Session.Format.Key).Count > 0 ? Session.Format.Key : null;
    }

    private void TogglePick(string arenaDeckId)
    {
        if (!_picked.Remove(arenaDeckId)) _picked.Add(arenaDeckId);
    }

    private async Task ImportArenaDecksAsync()
    {
        await Session.ImportArenaDecksAsync(_picked.ToList());
        await OnClose.InvokeAsync();
    }
}
