@using MtgaCollectionAdvisor.Core.Creators
@using MtgaCollectionAdvisor.Core.Models
@inject AdvisorSession Session

@* The deck's card list, wildcard gap and actions. Rendered as a drawer beneath the row
   it belongs to, so the deck stays where the user clicked it. *@

<div class="deck-detail">
    @* No name or colours here: the row just above says both. *@
    <div class="detail-header">
        <span class="result-count">
            @Shown.Needed.Total wildcards needed · @Shown.OwnedFraction.ToString("P0") of the list already yours
        </span>
        @if (Deck.HasNonBasicLands)
        {
            @* #61: a mana base is often most of a deck's rare wildcards and can wait; this shows
               the cost without it. A view only: nothing is stored, and another deck starts off. *@
            <label class="exclude-lands" title="Price and export this deck without its non-basic lands (duals, utility lands). Basic lands already cost nothing.">
                <input type="checkbox" @bind="_excludeLands" />
                Exclude non-basic lands
            </label>
        }
        <div class="detail-actions">
            @if (!string.IsNullOrWhiteSpace(Deck.Deck.Url))
            {
                @* A deck brought in from a creator video points back at the video: the
                   creator is the reason the deck is here, so that is where it sends people. *@
                <a class="button" href="@Deck.Deck.Url" target="_blank" rel="noopener">
                    @(CreatorVideo.IsVideoUrl(Deck.Deck.Url) ? "Watch video" : "Open source")
                </a>
            }
            <button class="primary" @onclick="() => OnCopy.InvokeAsync(Shown.Deck)">@(Copied ? "Copied!" : "Copy for Arena")</button>
            @if (Session.LigaMagicAvailable)
            {
                @* #62: players in Brazil price the real cards on Liga Magic. The list is copied
                   and the page opened in their own browser; the app never reads its prices. *@
                <button title="Copia a lista (sem terrenos básicos) e abre a Liga Magic no seu navegador para colar com Ctrl+V"
                        @onclick="() => OnQuote.InvokeAsync(Shown)">@(QuoteStatus ?? "Cotar na Liga Magic")</button>
            }
            @if (Deck.Deck.IsUserDeck)
            {
                @* Fetched decks are replaced wholesale on every refresh, so editing one
                   would be discarded without a word. *@
                <button @onclick="OnEdit">Edit</button>
            }
            <button @onclick="OnRemove">Remove</button>
        </div>
    </div>

    @if (_excludeLands)
    {
        var (copies, cost) = Deck.NonBasicLandShare();
        <div class="lands-note">@LandsNote(copies, cost)</div>
    }

    <div class="card-columns">
        <div>
            @if (Shown.Gaps.Any(g => g.Board == DeckBoard.Commander))
            {
                @* A Brawl deck's commander (#76), apart from the 99 as Arena shows it. *@
                <div class="card-list-title">Commander</div>
                @foreach (var gap in Shown.Gaps.Where(g => g.Board == DeckBoard.Commander).OrderBy(g => g.CardName))
                {
                    @RenderCardRow(gap)
                }
            }
            <div class="card-list-title">Mainboard</div>
            @foreach (var gap in Shown.Gaps.Where(g => g.Board == DeckBoard.Main).OrderBy(g => g.CardName))
            {
                @RenderCardRow(gap)
            }
        </div>

        @if (Shown.Gaps.Any(g => g.Board == DeckBoard.Sideboard))
        {
            <div>
                <div class="card-list-title">Sideboard</div>
                @foreach (var gap in Shown.Gaps.Where(g => g.Board == DeckBoard.Sideboard).OrderBy(g => g.CardName))
                {
                    @RenderCardRow(gap)
                }
            </div>
        }

        <div>
            <div class="card-list-title">Export (Arena format)</div>
            <textarea class="export-area" readonly>@Session.ExportDeck(Shown.Deck)</textarea>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public DeckAnalysisResult Deck { get; set; } = null!;

    /// <summary>True right after Copy for Arena, so the button can confirm.</summary>
    [Parameter] public bool Copied { get; set; }

    /// <summary>Copy for Arena, with the list as shown: without non-basic lands when excluded.</summary>
    [Parameter] public EventCallback<CandidateDeck> OnCopy { get; set; }
    /// <summary>What the Liga Magic button says after it was used; null before.</summary>
    [Parameter] public string? QuoteStatus { get; set; }

    /// <summary>Quote on Liga Magic (#62), with the list as shown, like Copy for Arena.</summary>
    [Parameter] public EventCallback<DeckAnalysisResult> OnQuote { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }

    private bool _excludeLands;
    private string? _deckId;

    // No memory (#61): opening another deck shows its original cost again.
    protected override void OnParametersSet()
    {
        if (_deckId == Deck.Deck.SourceId) return;
        _deckId = Deck.Deck.SourceId;
        _excludeLands = false;
    }

    /// <summary>What the panel shows and exports: the deck, or the deck without non-basic lands.</summary>
    private DeckAnalysisResult Shown => _excludeLands ? Deck.WithoutNonBasicLands() : Deck;

    private static string LandsNote(int copies, WildcardNeed cost)
    {
        var parts = new List<string>();
        if (cost.Mythics > 0) parts.Add($"{cost.Mythics} mythic");
        if (cost.Rares > 0) parts.Add($"{cost.Rares} rare");
        if (cost.Uncommons > 0) parts.Add($"{cost.Uncommons} uncommon");
        if (cost.Commons > 0) parts.Add($"{cost.Commons} common");

        var lands = $"{copies} non-basic land{(copies == 1 ? "" : "s")} left out";
        return parts.Count == 0
            ? $"{lands}: you already own them."
            : $"{lands}: {string.Join(", ", parts)} wildcard{(cost.Total == 1 ? "" : "s")}.";
    }

    private RenderFragment RenderCardRow(CardGap gap) => @<div class="card-row @CardRowClass(gap)">
        <span class="card-qty">@gap.Owned / @gap.Needed</span>
        <span class="card-name">
            @* The whole card on hover (#59), from Scryfall's image CDN. Hidden until then and
               lazy, so the browser fetches nothing for names the mouse only passes over. *@
            @if (gap.ImageUrl is { } front)
            {
                <span class="card-name-hover" tabindex="0">@gap.CardName
                    <span class="card-preview" role="tooltip">
                        <img src="@front" alt="@gap.CardName" loading="lazy" width="244" />
                        @if (gap.BackImageUrl is { } back)
                        {
                            <img src="@back" alt="@($"{gap.CardName}, back face")" loading="lazy" width="244" />
                        }
                    </span>
                </span>
            }
            else
            {
                @gap.CardName
            }
        </span>
        @if (!gap.AvailableOnArena)
        {
            <span class="card-unknown" title="@AdvisorSession.UnrecognisedHint">not recognised</span>
        }
        else if (gap.Missing > 0)
        {
            <span class="card-need @RarityClass(gap.Rarity)">need @gap.Missing</span>
        }
        else
        {
            <span class="card-have" title="You own all the copies this list needs">✓</span>
        }
    </div>;

    private static string CardRowClass(CardGap gap) =>
        gap.Missing == 0 ? "owned" : gap.Owned > 0 ? "partial" : "missing";

    private static string RarityClass(CardRarity rarity) => rarity switch
    {
        CardRarity.Common => "c",
        CardRarity.Uncommon => "u",
        CardRarity.Rare => "r",
        CardRarity.Mythic => "m",
        _ => ""
    };
}
