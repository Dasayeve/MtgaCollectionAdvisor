@page "/creators"
@implements IDisposable
@inject AdvisorSession Session
@inject NavigationManager Navigation
@using MtgaCollectionAdvisor.Core.Creators
@using MtgaCollectionAdvisor.Core.Models

@* Creator videos as a deck source. The video is always the way in - it sends people to
   the creator - and the deck, when its list can be read, is what makes a card worth
   more than a thumbnail. Every rule lives in Core/Creators; this page only renders. *@

<PageTitle>Creator decks</PageTitle>

@if (!Session.CreatorVideosEnabled)
{
    return;
}

<div class="creators-page">
    <div class="panel creators-toolbar">
        <div class="creators-heading">
            <h2>Creator decks</h2>

            @* Discreet on purpose: English is the default audience. A flag stands for English
               only, the globe for every language (Brazilian Portuguese today, more later).
               Inline SVG, not emoji: Windows draws flag emoji as the letters "US". *@
            <div class="lang-toggle" role="group" aria-label="Video language">
                <button type="button" class="@(_includeNonEnglish ? "" : "active")" aria-pressed="@(!_includeNonEnglish)"
                        title="English videos only" @onclick="() => _includeNonEnglish = false">
                    <svg viewBox="0 0 19 10" width="19" height="10" aria-hidden="true">
                        <rect width="19" height="10" fill="#b22234" />
                        <path d="M0 1.15h19M0 2.7h19M0 4.23h19M0 5.77h19M0 7.3h19M0 8.85h19" stroke="#fff" stroke-width=".77" />
                        <rect width="7.6" height="5.38" fill="#3c3b6e" />
                    </svg>
                    <span class="sr-only">English only</span>
                </button>
                <button type="button" class="@(_includeNonEnglish ? "active" : "")" aria-pressed="@_includeNonEnglish"
                        title="Videos in every language, including Brazilian Portuguese" @onclick="() => _includeNonEnglish = true">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <circle cx="8" cy="8" r="6.6" fill="none" stroke="currentColor" stroke-width="1.3" />
                        <path d="M1.4 8h13.2M8 1.4c2 1.9 2.9 4.1 2.9 6.6S10 12.7 8 14.6M8 1.4C6 3.3 5.1 5.5 5.1 8S6 12.7 8 14.6"
                              fill="none" stroke="currentColor" stroke-width="1.1" />
                    </svg>
                    <span class="sr-only">All languages</span>
                </button>
            </div>
            <span class="result-count">
                @Shown.Count of @Session.CreatorVideos.Count videos from @Session.CreatorChannelList.Count creators
            </span>
        </div>

        <div class="creators-filters">
            <select value="@_creator" aria-label="Creator" @onchange="e => _creator = e.Value?.ToString() ?? string.Empty">
                <option value="">All creators</option>
                @foreach (var channel in Session.CreatorChannelList.OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase))
                {
                    <option value="@channel.Name">@channel.Name</option>
                }
            </select>
            <label class="checkbox-row">
                <input type="checkbox" checked="@_onlyWithDeck" @onchange="e => _onlyWithDeck = (bool)e.Value!" />
                <span>Deck read automatically</span>
            </label>
            <label class="checkbox-row" title="@Session.WildcardHint">
                <input type="checkbox" checked="@_onlyCraftable" disabled="@(Session.Collection.Wildcards is null)"
                       @onchange="e => _onlyCraftable = (bool)e.Value!" />
                <span>Craftable now</span>
            </label>
            <label class="checkbox-row">
                <input type="checkbox" checked="@_onlyAppFormats" @onchange="e => _onlyAppFormats = (bool)e.Value!" />
                <span>Standard &amp; Pioneer only</span>
            </label>
            <select value="@_sort" aria-label="Sort" @onchange="OnSortChanged">
                <option value="@CreatorVideoSort.Newest">Newest first</option>
                <option value="@CreatorVideoSort.Cheapest">Cheapest to finish</option>
            </select>
            <button disabled="@Session.IsBusy"
                    title="Fetches every creator's latest videos now, instead of waiting for the cache to expire."
                    @onclick="() => Session.LoadCreatorVideosAsync(force: true)">
                Refresh
            </button>
        </div>
    </div>

    @if (Session.CreatorVideos.Count == 0)
    {
        <div class="panel empty">
            <h3>@(Session.IsBusy ? "Loading creator videos..." : "No creator videos loaded yet")</h3>
            <p>Videos come from each creator's public YouTube feed.</p>
        </div>
    }
    else if (Shown.Count == 0)
    {
        <div class="panel empty">
            <h3>No videos match the filters</h3>
            <p>Try another creator, or untick a filter.</p>
        </div>
    }
    else
    {
        <div class="video-grid">
            @foreach (var card in Shown)
            {
                var video = card.Video;
                <article class="video-card">
                    <a class="video-thumb" href="@video.Url" target="_blank" rel="noopener" title="Watch on YouTube">
                        <img src="@video.ThumbnailUrl" alt="" loading="lazy" />
                        <span class="play" aria-hidden="true">▶</span>
                    </a>

                    <div class="video-body">
                        <div class="video-title" title="@video.Title">@video.Title</div>
                        <div class="deck-meta">@video.Creator · @Ago(video.Published)</div>

                        @if (card.Analysis is { } deck)
                        {
                            <div class="video-deck">
                                <WildcardCost Needed="deck.Needed" />
                                <span class="owned-value">@deck.OwnedFraction.ToString("P0") owned</span>
                            </div>
                            <div class="video-format">
                                <ManaColors Colors="@deck.Colors" />
                                @if (card.IsLegalInAppFormat)
                                {
                                    <span class="format-chip">@card.Format!.DisplayName</span>
                                }
                                else
                                {
                                    <span class="format-chip off"
                                          title="Not legal in Standard or Pioneer: @string.Join(", ", deck.IllegalInFormat.Take(5))">
                                        Other format
                                    </span>
                                }
                                @if (Session.Collection.Wildcards is { } wallet && deck.Needed.IsAffordableWith(wallet))
                                {
                                    <span class="badge yes">craftable</span>
                                }
                            </div>
                        }
                        else if (video.Kind == DeckSourceKind.External)
                        {
                            <div class="video-deck muted">Deck on @video.ExternalSite</div>
                        }
                        else
                        {
                            <div class="video-deck muted">No list in the description</div>
                        }

                        @* Watch always comes first and sits in the same place on every card. *@
                        <div class="video-actions">
                            <a href="@video.Url" target="_blank" rel="noopener"><button class="primary">▶ Watch</button></a>
                            @if (card.Analysis is not null)
                            {
                                <button @onclick="() => _importing = card">Add to my decks</button>
                            }
                            else if (video.Kind == DeckSourceKind.External)
                            {
                                @* Opens the creator's list and our import side by side: export it
                                   there, paste it here. The app never reads that site. *@
                                <a href="@video.ExternalUrl" target="_blank" rel="noopener"
                                   @onclick="() => _importing = card">
                                    <button>Import deck</button>
                                </a>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>

@if (_importing is { } importing)
{
    <DeckDialog InitialName="@importing.Video.SuggestedDeckName"
                InitialDecklist="@importing.Video.Decklist"
                InitialFormat="@importing.Format"
                SourceUrl="@importing.Video.Url"
                OnClose="() => _importing = null" />
}

@code {
    private string _creator = string.Empty;
    private bool _onlyWithDeck;
    private bool _onlyCraftable;
    private bool _onlyAppFormats;

    // The app ships mainly in English; start from the user's own Windows language.
    private bool _includeNonEnglish =
        CreatorVideoFilterCriteria.IncludeNonEnglishByDefault(System.Globalization.CultureInfo.CurrentUICulture);
    private CreatorVideoSort _sort = CreatorVideoSort.Newest;
    private CreatorVideoCard? _importing;
    private bool _autoLoadStarted;

    protected override void OnInitialized()
    {
        // Off means the page does not exist, not that it is empty.
        if (!Session.CreatorVideosEnabled)
        {
            Navigation.NotFound();
            return;
        }

        Session.Changed += OnSessionChanged;
    }

    // Not during prerender, and not awaited: the page paints first and fills in as the
    // session reports progress.
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) TryAutoLoad();
    }

    /// <summary>
    /// Once per visit, as soon as the session is free. At startup the collection scan holds
    /// the session for a minute or two; loading only on first render left the page empty.
    /// Every visit, not just the first: a fresh cache costs only a re-price, and a stale one
    /// (or a creator whose feed failed last time) is exactly what a visit should fix.
    /// </summary>
    private void TryAutoLoad()
    {
        if (_autoLoadStarted || !Session.CreatorVideosEnabled || Session.IsBusy) return;
        _autoLoadStarted = true;
        _ = Session.LoadCreatorVideosAsync();
    }

    private void OnSessionChanged() => InvokeAsync(() =>
    {
        TryAutoLoad();
        StateHasChanged();
    });

    private void OnSortChanged(ChangeEventArgs e) =>
        _sort = Enum.TryParse<CreatorVideoSort>(e.Value?.ToString(), out var sort) ? sort : CreatorVideoSort.Newest;

    private IReadOnlyList<CreatorVideoCard> Shown => CreatorVideoFilter.Apply(
        Session.CreatorVideos,
        new CreatorVideoFilterCriteria
        {
            Creator = _creator,
            OnlyWithDeck = _onlyWithDeck,
            OnlyCraftable = _onlyCraftable,
            OnlyAppFormats = _onlyAppFormats,
            IncludeNonEnglish = _includeNonEnglish,
            Sort = _sort
        },
        Session.Collection.Wildcards);

    private static string Ago(DateTimeOffset when)
    {
        var days = (int)(DateTimeOffset.UtcNow - when).TotalDays;
        return days switch
        {
            <= 0 => "today",
            1 => "1 day ago",
            < 60 => $"{days} days ago",
            _ => when.ToString("d MMM yyyy")
        };
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
