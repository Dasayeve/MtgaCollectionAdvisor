@page "/"
@implements IDisposable
@inject AdvisorSession Session
@inject IJSRuntime JS
@using MtgaCollectionAdvisor.Core.Analysis
@using MtgaCollectionAdvisor.Core.Decks
@using MtgaCollectionAdvisor.Core.Models

<PageTitle>Recommended decks</PageTitle>

@if (Session.StartupError is not null)
{
    <div class="workspace" style="grid-template-columns: 1fr">
        <div class="panel empty">
            <h3>Database unavailable</h3>
            <p>@Session.StartupError</p>
            <p class="hint">
                Data lives in a SQLite file at
                <code>%LOCALAPPDATA%\MtgaCollectionAdvisor\advisor.db</code>.
                Check that the folder is writable and restart the app.
            </p>
        </div>
    </div>
    return;
}

<div class="workspace @(_filtersToggled ? "filters-toggled" : "")">
    <div class="filters-backdrop" @onclick="() => _filtersToggled = false"></div>

    <aside class="filters">
        <div class="filter-group">
            <h2 class="filter-title">Colours</h2>
            <div class="color-picker">
                @foreach (var color in "WUBRG")
                {
                    <button class="color-pip @(_selectedColors.Contains(color) ? "active" : "")"
                            title="@color"
                            @onclick="() => ToggleColor(color)">
                        <i class="ms ms-@(char.ToLowerInvariant(color)) ms-cost"></i>
                    </button>
                }
            </div>
            <label class="checkbox-row">
                <input type="checkbox" checked="@_exactColors" @onchange="e => _exactColors = (bool)e.Value!" />
                <span>Exactly these colours</span>
            </label>
            <div class="hint">
                @(_exactColors
                    ? "Only decks with this exact colour combination."
                    : "Decks that include the selected colours.")
            </div>
        </div>

        <div class="filter-group">
            <h2 class="filter-title">What I can build</h2>
            @* Unknown wildcards (#57) can't decide what is craftable: the option waits for them. *@
            <label class="checkbox-row" title="@Session.WildcardHint">
                <input type="checkbox" checked="@_onlyCraftable" disabled="@(Session.Collection.Wildcards is null)"
                       @onchange="e => _onlyCraftable = (bool)e.Value!" />
                <span>Craftable with my wildcards</span>
            </label>
            <label class="checkbox-row">
                <input type="checkbox" checked="@_onlyPinned"
                       @onchange="e => { _onlyPinned = (bool)e.Value!; _page = 1; }" />
                <span>Pinned only</span>
                <svg class="pinned-mark" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                    <path fill="currentColor" d="M5.75 1.5a1 1 0 0 0 0 2h.85v3.1L4.5 8.7A2.2 2.2 0 0 0 3.8
                        10.3V11h3.45L7.72 14.62a.3.3 0 0 0 .56 0L8.75 11h3.45v-.7a2.2 2.2 0 0 0-.7-1.6L9.4
                        6.6V3.5h.85a1 1 0 0 0 0-2Z" />
                </svg>
            </label>
        </div>

        <div class="filter-group">
            <h2 class="filter-title">Wildcard budget</h2>
            <input type="number" min="0" step="1" placeholder="No limit" aria-label="Wildcard budget"
                   value="@_maxWildcards"
                   @onchange="e => { _maxWildcards = ParseCap(e); _page = 1; }" />

            <h3 class="filter-subtitle">Per rarity</h3>
            <div class="rarity-budget">
                <label>
                    <span class="wc-part common">Common</span>
                    <input type="number" min="0" step="1" placeholder="Any" value="@_maxCommons"
                           @onchange="e => { _maxCommons = ParseCap(e); _page = 1; }" />
                </label>
                <label>
                    <span class="wc-part uncommon">Uncommon</span>
                    <input type="number" min="0" step="1" placeholder="Any" value="@_maxUncommons"
                           @onchange="e => { _maxUncommons = ParseCap(e); _page = 1; }" />
                </label>
                <label>
                    <span class="wc-part rare">Rare</span>
                    <input type="number" min="0" step="1" placeholder="Any" value="@_maxRares"
                           @onchange="e => { _maxRares = ParseCap(e); _page = 1; }" />
                </label>
                <label>
                    <span class="wc-part mythic">Mythic</span>
                    <input type="number" min="0" step="1" placeholder="Any" value="@_maxMythics"
                           @onchange="e => { _maxMythics = ParseCap(e); _page = 1; }" />
                </label>
            </div>
            <div class="hint">At most this many of each. Blank is no limit; 0 means none needed.</div>
        </div>

        <div class="filter-group">
            <h2 class="filter-title">Already owned</h2>
            <div class="owned-threshold">
                <input type="range" min="0" max="100" step="5" value="@_minOwnedPercent"
                       aria-label="Minimum share of the list already owned"
                       @oninput="e => { _minOwnedPercent = int.TryParse(e.Value?.ToString(), out var v) ? v : 0; _page = 1; }" />
                <span class="owned-threshold-value">@(_minOwnedPercent)%</span>
            </div>
            <div class="hint">At least this much of the list already yours.</div>
        </div>

        <div class="filter-group">
            <h2 class="filter-title">Cards</h2>
            <CardPicker Label="Must include" Cards="_containsCards" CardsChanged="OnContainsChanged" />
            <CardPicker Label="Must exclude" Cards="_excludesCards" CardsChanged="OnExcludesChanged" />
        </div>

        <div class="filter-group">
            <h2 class="filter-title">Deck name</h2>
            <input type="text" placeholder="Search" aria-label="Deck name"
                   value="@_search"
                   @oninput="e => _search = e.Value?.ToString() ?? string.Empty" />
        </div>
    </aside>

    <section class="deck-list">
        <div class="page-head">
            @* Collapses the filter column, or opens it as a drawer in a narrow window. The count
               says filters still apply while the column is out of sight. *@
            @{ var activeFilters = BuildCriteria().ActiveCount; }
            <button type="button" class="filters-toggle @(activeFilters > 0 ? "has-active" : "")"
                    title="Show or hide the filters" @onclick="() => _filtersToggled = !_filtersToggled">
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                    <path fill="currentColor" d="M1.5 3.25a.75.75 0 0 1 .75-.75h11.5a.75.75 0 0 1 0
                        1.5H2.25a.75.75 0 0 1-.75-.75Zm2 4.5a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0
                        1.5h-7.5a.75.75 0 0 1-.75-.75Zm2 4.5a.75.75 0 0 1 .75-.75h3.5a.75.75 0 0 1 0
                        1.5h-3.5a.75.75 0 0 1-.75-.75Z" />
                </svg>
                Filters
                @if (activeFilters > 0)
                {
                    <span class="filter-count">@activeFilters</span>
                }
            </button>
            <h1>Decks</h1>

            @* The format is what the whole page is about, so it sits in the title rather than among
               the filters. The most played ones as buttons, one click each; the rest in a menu, so
               the switch stays one row however many formats the app ranks (#76). *@
            <div class="segmented" role="group" aria-label="Format">
                @foreach (var format in Formats.Main)
                {
                    <button class="@(Session.Format.Key == format.Key ? "active" : "")"
                            aria-pressed="@(Session.Format.Key == format.Key)"
                            disabled="@Session.IsBusy"
                            @onclick="() => ChangeFormatAsync(format)">
                        @format.DisplayName
                    </button>
                }
            </div>
            @if (Formats.More.Count > 0)
            {
                var inMore = Formats.More.Any(f => f.Key == Session.Format.Key);
                <select class="format-more @(inMore ? "active" : "")" aria-label="More formats"
                        disabled="@Session.IsBusy" @onchange="ChangeToMoreFormatAsync">
                    <option value="" selected="@(!inMore)">More formats</option>
                    @foreach (var format in Formats.More)
                    {
                        <option value="@format.Key" selected="@(Session.Format.Key == format.Key)">@format.DisplayName</option>
                    }
                </select>
            }
        </div>

        @* #57, said where it matters: without wildcards, nothing here can say what is craftable. *@
        @if (Session.WildcardHint is { } hint)
        {
            <p class="notice"><strong>Wildcards not read yet.</strong> @hint</p>
        }

        <div class="list-header">
            <div class="tabs" role="tablist">
                <button role="tab" class="@(_tab == DeckTab.Suggestions ? "active" : "")"
                        aria-selected="@(_tab == DeckTab.Suggestions)"
                        @onclick="() => ShowTab(DeckTab.Suggestions)">
                    Suggested
                </button>
                <button role="tab" class="@(_tab == DeckTab.User ? "active" : "")"
                        aria-selected="@(_tab == DeckTab.User)"
                        @onclick="() => ShowTab(DeckTab.User)">
                    My decks
                    @if (UserDeckCount > 0)
                    {
                        <span class="tab-count">@UserDeckCount</span>
                    }
                </button>
            </div>
            <span class="result-count">
                @Filtered.Count of @Available.Count decks
                @if (HasActiveFilters)
                {
                    <text> · </text><button type="button" class="link" @onclick="ClearFilters">Clear filters</button>
                }
            </span>
        </div>

        @if (_tab == DeckTab.User && Available.Count == 0)
        {
            var elsewhere = Formats.All
                .Where(f => f.Key != Session.Format.Key && Session.UserDeckCounts.GetValueOrDefault(f.Key) > 0)
                .ToList();
            <div class="empty">
                @if (elsewhere.Count > 0)
                {
                    @* The list follows the format switch: with decks in another format, an empty
                       tab reads as the decks being gone (#76). *@
                    <h3>No @Session.Format.DisplayName decks of your own</h3>
                    <p>
                        Your other decks are in
                        @for (var i = 0; i < elsewhere.Count; i++)
                        {
                            var format = elsewhere[i];
                            var count = Session.UserDeckCounts[format.Key];
                            @(i == 0 ? "" : i == elsewhere.Count - 1 ? " and " : ", ")
                            <button class="link-button" disabled="@Session.IsBusy" @onclick="() => ChangeFormatAsync(format)">@format.DisplayName (@count)</button>
                        }.
                    </p>
                }
                else
                {
                    <h3>No decks of your own yet</h3>
                    <p>
                        Click <strong>Import deck</strong> to paste a list in Arena's export format.
                        Your decks stay here whatever happens to the fetched pool.
                    </p>
                }
            </div>
        }
        else if (Session.Decks.Count == 0)
        {
            <div class="empty">
                <h3>No decks loaded</h3>
                <p>Click <strong>Fetch decks</strong> to pull public @Session.Format.DisplayName lists.</p>
            </div>
        }
        else if (Available.Count == 0)
        {
            @* Decks are stored, but none survive the legality and Arena checks, so
               telling the user to loosen their filters would send them nowhere. *@
            <div class="empty">
                <h3>None of the fetched decks are playable</h3>
                <p>
                    Every @Session.Format.DisplayName list pulled so far is either illegal in the
                    format or uses cards missing from Arena. Try <strong>Fetch decks</strong> again,
                    or <strong>Update cards</strong> if the card database is out of date.
                </p>
            </div>
        }
        else if (Filtered.Count == 0)
        {
            <div class="empty">
                <h3>No decks match the filters</h3>
                <p>Loosen the colours or raise the wildcard budget.</p>
            </div>
        }
        else
        {
            <table class="deck-table">
                <thead>
                    <tr>
                        <th class="pin-col"></th>
                        <th class="sortable @SortClass(SortKey.Name)" @onclick="() => Sort(SortKey.Name)">Deck@(SortArrow(SortKey.Name))</th>
                        <th>Colours</th>
                        <th class="sortable @SortClass(SortKey.Wildcards)" @onclick="() => Sort(SortKey.Wildcards)">Wildcards needed@(SortArrow(SortKey.Wildcards))</th>
                        <th class="sortable col-owned @SortClass(SortKey.Owned)" @onclick="() => Sort(SortKey.Owned)">Owned@(SortArrow(SortKey.Owned))</th>
                        <th>Can I build it?</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var deck in PageItems)
                    {
                        <tr class="@(ReferenceEquals(deck, _selected) ? "selected open" : "")" @onclick="() => Select(deck)">
                            <td class="pin-col" @onclick:stopPropagation>
                                <button class="pin @(Session.IsPinned(deck.Deck.SourceId) ? "on" : "")"
                                        title="@(Session.IsPinned(deck.Deck.SourceId) ? "Unpin" : "Pin to track progress")"
                                        @onclick="() => Session.TogglePinAsync(deck)">
                                    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                                        <path fill="currentColor" d="M5.75 1.5a1 1 0 0 0 0 2h.85v3.1L4.5 8.7A2.2 2.2 0 0 0 3.8
                                            10.3V11h3.45L7.72 14.62a.3.3 0 0 0 .56 0L8.75 11h3.45v-.7a2.2 2.2 0 0 0-.7-1.6L9.4
                                            6.6V3.5h.85a1 1 0 0 0 0-2Z" />
                                    </svg>
                                </button>
                            </td>
                            <td>
                                <div class="deck-name">@deck.Deck.Name</div>
                                <div class="deck-meta">
                                    @if (deck.Deck.IsUserDeck)
                                    {
                                        <text>Imported @deck.Deck.FetchedAt.LocalDateTime.ToString("d MMM yyyy")</text>
                                    }
                                    else
                                    {
                                        <text>@deck.Deck.Popularity.ToString("N0") views</text>
                                    }
                                    @if (Progress(deck) is { } moved && moved != 0)
                                    {
                                        <span class="progress @(moved > 0 ? "down" : "up")">
                                            @(moved > 0 ? $"▼ {moved} since pinned" : $"▲ {-moved} since pinned")
                                        </span>
                                    }
                                </div>
                                @* Only reachable on the My decks tab - Suggested drops these. *@
                                @if (deck.UnavailableOnArena.Count > 0)
                                {
                                    <div class="deck-warning" title="@AdvisorSession.UnrecognisedHint">Not recognised: @string.Join(", ", deck.UnavailableOnArena)</div>
                                }
                                @if (deck.IllegalInFormat.Count > 0)
                                {
                                    <div class="deck-warning">Not legal in @Session.Format.DisplayName: @string.Join(", ", deck.IllegalInFormat)</div>
                                }
                            </td>
                            <td><ManaColors Colors="@deck.Colors" /></td>
                            <td>
                                <WildcardCost Needed="deck.Needed" UnrecognisedCopies="deck.UnrecognisedCopies" />
                            </td>
                            <td class="col-owned">
                                <div class="owned-cell">
                                    <div class="owned-bar"><div style="width:@((deck.OwnedFraction * 100).ToString("F0"))%"></div></div>
                                    <span class="owned-value @(deck.OwnedFraction >= 1 ? "complete" : "")">@deck.OwnedFraction.ToString("P0")</span>
                                </div>
                            </td>
                            <td>
                                @* Says why not, so a "no" tells the player what it would take. *@
                                @if (!deck.FullyPlayableOnArena)
                                {
                                    @* #87: with cards the app doesn't know, it can't say. *@
                                    <span class="verdict unknown" title="@AdvisorSession.UnrecognisedHint">Can't tell: cards not recognised</span>
                                }
                                else if (Session.Collection.Wildcards is not { } wallet)
                                {
                                    <span class="verdict unknown" title="@Session.WildcardHint">Wildcards unknown</span>
                                }
                                else if (deck.Needed.ShortfallAgainst(wallet).DescribeShortfall() is { } shortfall)
                                {
                                    <span class="verdict no">@shortfall</span>
                                }
                                else
                                {
                                    <span class="verdict yes">Yes</span>
                                }
                            </td>
                        </tr>

                        @if (ReferenceEquals(deck, _selected))
                        {
                            @* A sibling row, deliberately without the row click handler:
                               clicking inside the drawer must not close it. *@
                            <tr class="detail-row">
                                <td colspan="6">
                                    <DeckDetail Deck="deck"
                                                Copied="_copied"
                                                OnCopy="CopyDeckAsync"
                                                QuoteStatus="@_quoteStatus"
                                                OnQuote="QuoteDeckAsync"
                                                OnEdit="() => _editing = deck"
                                                OnRemove="() => Session.DeleteDeckAsync(deck.Deck.SourceId)" />
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div class="pagination">
                <div class="page-size">
                    <span>Per page</span>
                    <select value="@_pageSize" @onchange="ChangePageSize">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </div>
                <div class="page-controls">
                    <button disabled="@(_page <= 1)" @onclick="() => GoToPage(_page - 1)">‹ Previous</button>
                    <span class="page-info">Page @_page of @TotalPages</span>
                    <button disabled="@(_page >= TotalPages)" @onclick="() => GoToPage(_page + 1)">Next ›</button>
                </div>
            </div>
        }
    </section>
</div>

@if (_editing is not null)
{
    <DeckDialog Deck="_editing.Deck" OnClose="() => _editing = null" />
}

@code {
    private enum SortKey { Wildcards, Owned, Name }

    private enum DeckTab { Suggestions, User }

    private readonly HashSet<char> _selectedColors = [];
    private bool _exactColors;
    private bool _onlyCraftable;
    private int? _maxWildcards;
    private int? _maxCommons;
    private int? _maxUncommons;
    private int? _maxRares;
    private int? _maxMythics;

    /// <summary>Whole percent, 0-100. Zero means no threshold.</summary>
    private int _minOwnedPercent;
    private string _search = string.Empty;
    private bool _onlyPinned;
    private IReadOnlyList<string> _containsCards = [];
    private IReadOnlyList<string> _excludesCards = [];

    private SortKey _sortBy = SortKey.Wildcards;
    private bool _descending;
    private int _page = 1;
    private int _pageSize = 25;

    private DeckAnalysisResult? _selected;
    private bool _copied;
    private string? _quoteStatus;
    private DeckTab _tab = DeckTab.Suggestions;

    /// <summary>The deck whose edit dialog is open, if any.</summary>
    private DeckAnalysisResult? _editing;

    /// <summary>
    /// The Filters button's state, read by width in CSS: in a wide window it collapses the
    /// filter column, in a narrow one (where the column is a drawer, closed by default) it
    /// opens the drawer. One flag, so the list never has to know how wide the window is.
    /// </summary>
    private bool _filtersToggled;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;

        // A deck imported from another page (the Creators tab's dialog) lands here on its tab,
        // the same as one imported on this page.
        if (Session.ConsumeLastImport() is not null) _tab = DeckTab.User;
    }

    private void OnSessionChanged() => InvokeAsync(() =>
    {
        // The selected deck object is replaced on every re-rank; keep the selection by id.
        if (_selected is not null)
        {
            _selected = Session.Decks.FirstOrDefault(d => d.Deck.SourceId == _selected.Deck.SourceId);
        }

        // A deck that was just imported only lives on the other tab, and leaving the user
        // on Suggestions would look exactly like the import having failed. The row itself
        // is enough: it sorts to the top of a short list. Opening its detail as well would
        // put what they want at the bottom of the page (see #15).
        if (Session.ConsumeLastImport() is not null)
        {
            _tab = DeckTab.User;
            _selected = null;
        }

        _page = 1;
        StateHasChanged();
    });

    /// <summary>
    /// The detail is a drawer under its own row now, so a selection whose row is not on
    /// the page would be an open drawer nobody can see.
    /// </summary>
    private void GoToPage(int page)
    {
        _page = page;
        _selected = null;
    }

    private void ShowTab(DeckTab tab)
    {
        if (_tab == tab) return;

        _tab = tab;
        _page = 1;
        _selected = null; // the selection belongs to the tab it was picked from
    }

    private async Task ChangeFormatAsync(FormatDefinition format)
    {
        _selected = null;
        await Session.SetFormatAsync(format);
    }

    private async Task ChangeToMoreFormatAsync(ChangeEventArgs e)
    {
        if (Formats.All.FirstOrDefault(f => f.Key == e.Value?.ToString()) is { } format) await ChangeFormatAsync(format);
    }

    private void ToggleColor(char color)
    {
        if (!_selectedColors.Remove(color)) _selectedColors.Add(color);
        _page = 1;
    }

    private void ClearFilters()
    {
        _selectedColors.Clear();
        _exactColors = false;
        _onlyCraftable = false;
        _maxWildcards = null;
        _maxCommons = null;
        _maxUncommons = null;
        _maxRares = null;
        _maxMythics = null;
        _minOwnedPercent = 0;
        _search = string.Empty;
        _containsCards = [];
        _excludesCards = [];
        _onlyPinned = false;
        _page = 1;
    }

    // A card in both lists would make the filter unsatisfiable, so adding it to one
    // side removes it from the other.
    private void OnContainsChanged(IReadOnlyList<string> cards)
    {
        _containsCards = cards;
        _excludesCards = _excludesCards.Where(c => !cards.Contains(c, StringComparer.OrdinalIgnoreCase)).ToList();
        _page = 1;
    }

    private void OnExcludesChanged(IReadOnlyList<string> cards)
    {
        _excludesCards = cards;
        _containsCards = _containsCards.Where(c => !cards.Contains(c, StringComparer.OrdinalIgnoreCase)).ToList();
        _page = 1;
    }

    /// <summary>A blank or unparseable number input is "no limit", never zero.</summary>
    private static int? ParseCap(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var v) ? v : null;

    private bool HasActiveFilters => !BuildCriteria().IsEmpty;

    private void Sort(SortKey key)
    {
        if (_sortBy == key) _descending = !_descending;
        else (_sortBy, _descending) = (key, key != SortKey.Wildcards);
        _page = 1;
    }

    private string SortClass(SortKey key) => _sortBy == key ? "active" : "";

    /// <summary>The sorted column says which way it runs; the others say nothing.</summary>
    private string SortArrow(SortKey key) => _sortBy != key ? "" : _descending ? " ↓" : " ↑";

    private void ChangePageSize(ChangeEventArgs e)
    {
        _pageSize = int.TryParse(e.Value?.ToString(), out var size) ? size : 25;
        _page = 1;
        _selected = null;
    }

    private void Select(DeckAnalysisResult deck)
    {
        _selected = ReferenceEquals(deck, _selected) ? null : deck;
        _copied = false;
        _quoteStatus = null;
    }

    // The deck as the panel shows it: without its non-basic lands when those are excluded (#61).
    private async Task CopyDeckAsync(CandidateDeck deck)
    {
        if (_selected is null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Session.ExportDeck(deck));
            _copied = true;
        }
        catch
        {
            _copied = false; // clipboard blocked - the textarea below is the fallback
        }
    }

    // Copies the list, then opens Liga Magic in the player's browser, where they paste it (#62).
    private async Task QuoteDeckAsync(DeckAnalysisResult deck)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", LigaMagicList.Write(deck));
        }
        catch
        {
            _quoteStatus = "Não foi possível copiar a lista";
            return;
        }

        _quoteStatus = Session.OpenLigaMagic()
            ? "Copiado! Cole na Liga Magic (Ctrl+V)"
            : "Copiado! Abra a Liga Magic e cole (Ctrl+V)";
    }

    private DeckFilterCriteria BuildCriteria() => new()
    {
        Colors = _selectedColors,
        ExactColors = _exactColors,
        OnlyCraftable = _onlyCraftable,
        MaxWildcards = _maxWildcards,
        RarityBudget = new RarityBudget(_maxCommons, _maxUncommons, _maxRares, _maxMythics),
        MinOwnedFraction = _minOwnedPercent > 0 ? _minOwnedPercent / 100.0 : null,
        NameSearch = _search,
        ContainsCards = _containsCards,
        ExcludesCards = _excludesCards,
        OnlyPinned = _onlyPinned,
        PinnedSourceIds = Session.Pins.Keys.ToHashSet(),

        Source = _tab == DeckTab.User ? DeckSourceFilter.User : DeckSourceFilter.Fetched,

        // A list someone else filed under this format is worth nothing if it is not
        // actually legal or not all on Arena. A deck the user typed in is worth showing
        // regardless - they asked for it, and the row says what is wrong with it.
        IncludeUnplayable = _tab == DeckTab.User
    };

    /// <summary>Wildcards saved since the deck was pinned; positive means closer to done.</summary>
    private int? Progress(DeckAnalysisResult deck) =>
        Session.Pins.TryGetValue(deck.Deck.SourceId, out var pin)
            ? pin.WildcardsWhenPinned - deck.Needed.Total
            : null;

    /// <summary>
    /// What this list could show if the user cleared every filter. Not the whole ranking:
    /// Session.Decks now carries decks that are illegal or not all on Arena, and counting
    /// those would read as "your filters are hiding 41 decks" when they are not.
    /// </summary>
    private List<DeckAnalysisResult> Available
    {
        get
        {
            var tab = BuildCriteria();
            return DeckFilter.Apply(
                Session.Decks,
                new DeckFilterCriteria { Source = tab.Source, IncludeUnplayable = tab.IncludeUnplayable },
                Session.Collection.Wildcards).ToList();
        }
    }

    private int UserDeckCount => Session.Decks.Count(d => d.Deck.IsUserDeck);

    private List<DeckAnalysisResult> Filtered
    {
        get
        {
            IEnumerable<DeckAnalysisResult> query =
                DeckFilter.Apply(Session.Decks, BuildCriteria(), Session.Collection.Wildcards);

            query = (_sortBy, _descending) switch
            {
                (SortKey.Wildcards, false) => query.OrderBy(d => d.Needed.Total).ThenByDescending(d => d.OwnedFraction),
                (SortKey.Wildcards, true) => query.OrderByDescending(d => d.Needed.Total),
                (SortKey.Owned, false) => query.OrderBy(d => d.OwnedFraction),
                (SortKey.Owned, true) => query.OrderByDescending(d => d.OwnedFraction),
                (SortKey.Name, false) => query.OrderBy(d => d.Deck.Name),
                _ => query.OrderByDescending(d => d.Deck.Name)
            };

            return query
                .OrderByDescending(d => Session.IsPinned(d.Deck.SourceId))
                .ToList();
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Filtered.Count / (double)_pageSize));

    private IEnumerable<DeckAnalysisResult> PageItems
    {
        get
        {
            var filtered = Filtered;
            var page = Math.Clamp(_page, 1, Math.Max(1, (int)Math.Ceiling(filtered.Count / (double)_pageSize)));
            return filtered.Skip((page - 1) * _pageSize).Take(_pageSize);
        }
    }


    // The top bar shows which wildcard totals fall short of the open deck. Set after every
    // render, so every way the selection changes (a click, a page, a tab, a re-rank) is covered.
    protected override void OnAfterRender(bool firstRender) => Session.SetOpenDeck(_selected?.Needed);

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Session.SetOpenDeck(null); // leaving the page closes the deck
    }
}
