<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\MtgaCollectionAdvisor.Core\MtgaCollectionAdvisor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- A console app gets a terminal window next to its own, and closing that window kills the
       server, so the release workflow builds without one (-p:WindowsAppNoConsole=true).
       OutputType must stay Exe: Blazor's framework files (blazor.web.js) are only added to
       Exe projects, and a WinExe build loads with no button working and no error (#54).
       This is the flag the SDK itself sets for WinExe to make the app host a GUI program. -->
  <PropertyGroup Condition="'$(WindowsAppNoConsole)' == 'true'">
    <_UseWindowsGraphicalUserInterface>true</_UseWindowsGraphicalUserInterface>
  </PropertyGroup>

  <!-- macOS: task_for_pid refuses a binary not signed with the com.apple.security.cs.debugger
       entitlement. The SDK signs the apphost and the published binary without it, so both are
       re-signed here (ad-hoc is enough locally; a signed release passes the plist to vpk). -->
  <PropertyGroup>
    <MacEntitlementsFile>$(MSBuildProjectDirectory)/Entitlements.plist</MacEntitlementsFile>
  </PropertyGroup>

  <Target Name="SignMacAppHost" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Condition="Exists('$(TargetDir)$(AssemblyName)')"
          Command="codesign -s - -f --entitlements &quot;$(MacEntitlementsFile)&quot; &quot;$(TargetDir)$(AssemblyName)&quot;" />
  </Target>

  <Target Name="SignMacPublishedApp" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Condition="Exists('$(PublishDir)$(AssemblyName)')"
          Command="codesign -s - -f --entitlements &quot;$(MacEntitlementsFile)&quot; &quot;$(PublishDir)$(AssemblyName)&quot;" />
  </Target>

</Project>
